#!/usr/bin/env nix-shell
#!nix-shell shell.nix -i python3
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PREVIEW_RMSE_MAX = 0.005
DEFAULT_CAMERA = [55, 0, 25]
NAME = re.compile(r"^[A-Za-z0-9_]+$")


def fail(manifest, msg):
    sys.exit(f"{manifest.relative_to(ROOT)}: {msg}")


def is_number(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def load(manifest):
    try:
        data = json.loads(manifest.read_text())
    except ValueError as e:
        fail(manifest, f"invalid JSON: {e}")
    if not isinstance(data, dict) or set(data) != {"source", "parts"}:
        fail(manifest, 'must be an object with exactly the keys "source" and "parts"')
    source = manifest.parent / str(data["source"])
    if not isinstance(data["source"], str) or not source.is_file():
        fail(manifest, f'"source" must name an existing file, got {data["source"]!r}')
    parts = data["parts"]
    if not isinstance(parts, dict) or not parts:
        fail(manifest, '"parts" must be a non-empty object keyed by part name')
    for name, spec in parts.items():
        if not NAME.match(name):
            fail(manifest, f"part name {name!r} must match {NAME.pattern}")
        if not isinstance(spec, dict) or not set(spec) <= {"define", "camera"}:
            fail(manifest, f'part {name!r} may only have the keys "define" and "camera"')
        define = spec.get("define", {"part": name})
        if not isinstance(define, dict) or not define or not all(
            isinstance(k, str) and isinstance(v, (str, int, float, bool)) for k, v in define.items()
        ):
            fail(manifest, f'part {name!r}: "define" must map variable names to strings, numbers or booleans')
        camera = spec.get("camera", DEFAULT_CAMERA)
        if not (isinstance(camera, list) and len(camera) == 3 and all(map(is_number, camera))):
            fail(manifest, f'part {name!r}: "camera" must be three numbers [rotx, roty, rotz]')
        parts[name] = (define, camera)
    return source, parts


def openscad(source, out, *args):
    cmd = ["openscad", "-q", "-o", str(out), *args, str(source)]
    if out.suffix == ".png":
        cmd = ["xvfb-run", "-a", *cmd]
    subprocess.run(cmd, check=True)


def rmse(a, b):
    r = subprocess.run(["magick", "compare", "-metric", "RMSE", str(a), str(b), "null:"], capture_output=True, text=True)
    m = re.search(r"\(([\d.e+-]+)\)", r.stderr)
    return float(m.group(1)) if r.returncode in (0, 1) and m else float("inf")


def build(manifest):
    source, parts = load(manifest)
    out = manifest.parent / "out"
    out.mkdir(exist_ok=True)
    keep = set()
    for name, (define, camera) in parts.items():
        stl, png = out / f"{name}.stl", out / f"{name}.png"
        keep |= {stl, png}
        print(stl.relative_to(ROOT), flush=True)
        openscad(source, stl, *(f"-D{k}={json.dumps(v)}" for k, v in define.items()))
        with tempfile.TemporaryDirectory() as tmp:
            scene, fresh = Path(tmp) / "preview.scad", Path(tmp) / png.name
            scene.write_text(f"import({json.dumps(str(stl))});\n")
            openscad(scene, fresh, "--camera=0,0,0,%g,%g,%g,500" % tuple(camera), "--viewall", "--autocenter", "--imgsize=1200,900", "--projection=p")
            if not png.exists() or rmse(png, fresh) > PREVIEW_RMSE_MAX:
                print(png.relative_to(ROOT), flush=True)
                fresh.replace(png)
    for stale in out.iterdir():
        if stale not in keep:
            stale.unlink()


manifests = sorted(ROOT.rglob("model.json"))
if not manifests:
    sys.exit("no model.json found")
for m in manifests:
    build(m)
